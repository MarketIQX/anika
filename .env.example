# Anika — environment variables.
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to git.

# -- Gmail OAuth (desktop app credentials from Google Cloud Console) --
# Scopes used: gmail.readonly, gmail.compose, gmail.send, gmail.labels, gmail.modify
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# The inbox Anika monitors and sends from
PRAKASHA_EMAIL=prakasha@balakrishnaandco.com

# Where notification emails land when a draft is ready for approval.
# Default: PRAKASHA_EMAIL (Prakash sir notifies himself).
# Leave blank to use PRAKASHA_EMAIL.
APPROVAL_NOTIFY_EMAIL=

# -- OpenAI --
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_MODEL_DRAFTER=gpt-4o
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini
OPENAI_MODEL_ENRICHER=gpt-4o-mini
OPENAI_MODEL_LEARNER=gpt-4o-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# -- App --
# Public base URL used in approval notification emails (the link Prakash sir clicks).
# Set this to the Cloudflare Tunnel hostname once set up, e.g. https://anika.mydomain.com
# Defaults to http://localhost:8000 (pilot / LAN).
ANIKA_PUBLIC_BASE_URL=http://localhost:8000

# Host/port the uvicorn server binds to
ANIKA_HOST=127.0.0.1
ANIKA_PORT=8000

# Gmail poll cadence (seconds)
GMAIL_POLL_INTERVAL_SECONDS=30

# Daily send cap (month-1 safety)
DAILY_SEND_CAP=30

# Undo window between approval and actual send (seconds)
UNDO_WINDOW_SECONDS=10

# Test mode — when true, Sender writes to sent_log but does not hit Gmail API
ANIKA_TEST_MODE=false

# Timezone
ANIKA_TZ=Asia/Kolkata

# -- Auth (dashboard login) --
# Session cookie signing secret — rotate to invalidate all sessions.
# CHANGE THIS before going live. A long random string is fine.
SESSION_SECRET=change-me-in-production-please
SESSION_MAX_AGE_DAYS=7
# Set to true once running behind HTTPS (Cloudflare Tunnel / real TLS).
SESSION_COOKIE_SECURE=false

# First-boot user seed. If left empty, random passwords are generated and
# printed ONCE to the console on first boot. After the users rows are
# created, these vars are ignored.
AK_EMAIL=aks@marketiqx.com
AK_INITIAL_PASSWORD=
PRAKASHA_INITIAL_PASSWORD=
